# Copy to .env (gitignored). Per-cluster DB roles in prod (schema-scoped grants);
# one superuser locally is fine. Never commit real secrets — use SOPS/Doppler in prod.

# --- Database (local dev points at docker-compose db on 5433) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app
# Per-cluster roles in prod, e.g.:
# IAM_DATABASE_URL=postgres://iam_role:***@data-host:5432/app
# PLATFORM_DATABASE_URL=postgres://platform_role:***@data-host:5432/app

# --- Cache / queue / broker ---
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222   # extraction stage only

# --- Auth (identity cluster) ---
JWT_ACCESS_SECRET=dev-only-change-me
JWT_REFRESH_SECRET=dev-only-change-me-too
JWT_ACCESS_TTL=900          # 15 min
JWT_REFRESH_TTL=2592000     # 30 days

# --- Runtime ---
APP_ENV=dev                 # dev | staging | prod  (gates seeds)
PORT=3000

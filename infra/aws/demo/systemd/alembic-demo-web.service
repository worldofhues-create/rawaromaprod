# DEMO-INFRA: demo ALEMBIC Next renderer on 127.0.0.1:3010 (prod: 3000). Installed, DISABLED.
[Unit]
Description=Alembic DEMO web
After=network-online.target alembic-demo-api.socket
Wants=alembic-demo-api.socket
[Service]
Type=exec
User=alembic-demo
Group=alembic-demo
WorkingDirectory=/srv/alembic-demo/app/apps/web
EnvironmentFile=/etc/alembic-demo/web.env
Environment=HOSTNAME=127.0.0.1 HOST=127.0.0.1 PORT=3010 NODE_ENV=production NEXT_CACHE_DIR=/srv/alembic-demo/var/web-cache
ExecStart=/srv/alembic-demo/app/apps/web/node_modules/.bin/next start -H 127.0.0.1 -p 3010
StandardOutput=append:/var/log/alembic-demo/web.log
StandardError=append:/var/log/alembic-demo/web.log
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5s
ReadWritePaths=/srv/alembic-demo/var/web-cache
MemoryMax=450M
# H1: no demo process may reach IMDS (the box role is a PROD role). IPv4 + IPv6 IMDS endpoints.
IPAddressDeny=169.254.169.254/32 fd00:ec2::254/128
Environment=AWS_EC2_METADATA_DISABLED=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
# demo must never starve production on the shared t4g.medium: hard memory cap + half the CPU weight of prod units
CPUWeight=50
[Install]
WantedBy=multi-user.target

# DEMO-INFRA: demo ALEMBIC API — same artifact as prod (deployed to /srv/alembic-demo/app by P0), own DB/role/env.
# Installed, DISABLED. Enable only after reset-demo.sh has written /etc/alembic-demo/tenant-id.
[Unit]
Description=Alembic DEMO API
Requires=alembic-demo-api.socket
After=network-online.target alembic-demo-migrate.service
Requires=alembic-demo-migrate.service
Wants=alembic-demo-aws-creds.service
After=alembic-demo-aws-creds.service
[Service]
Type=exec
User=alembic-demo
Group=alembic-demo
WorkingDirectory=/srv/alembic-demo/app
EnvironmentFile=/etc/alembic-demo/api.env
ExecStart=/usr/bin/node apps/api/src/index.ts
StandardOutput=append:/var/log/alembic-demo/api.log
StandardError=append:/var/log/alembic-demo/api.log
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5s
ReadWritePaths=/srv/alembic-demo/var /srv/alembic-demo/app
MemoryDenyWriteExecute=false
MemoryMax=450M
# H1: no demo process may reach IMDS (the box role is a PROD role). IPv4 + IPv6 IMDS endpoints.
IPAddressDeny=169.254.169.254/32 fd00:ec2::254/128
Environment=AWS_EC2_METADATA_DISABLED=true
# short-lived demo-role session written by root (alembic-demo-aws-creds.timer); credential_process, no credential_source
Environment=AWS_CONFIG_FILE=/etc/alembic-demo/aws/config AWS_SHARED_CREDENTIALS_FILE=/etc/alembic-demo/aws/credentials AWS_SDK_LOAD_CONFIG=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
# demo must never starve production on the shared t4g.medium: hard memory cap + half the CPU weight of prod units
CPUWeight=50
[Install]
WantedBy=multi-user.target

# DEMO-INFRA: Vault DEMO API (PORT 4111, vault box; KMS via role rawprod-vault-demo). Same artifact as prod, deployed to /srv/rawprod-demo/app. Installed, DISABLED.
[Unit]
Description=Vault DEMO API (PORT 4111, vault box; KMS via role rawprod-vault-demo)
After=network-online.target vault-demo-migrate.service
Requires=vault-demo-migrate.service
Wants=vault-demo-aws-creds.service
After=vault-demo-aws-creds.service
[Service]
Type=exec
User=rawprod-demo
Group=rawprod-demo
WorkingDirectory=/srv/rawprod-demo/app
EnvironmentFile=/etc/rawprod-demo/vault.env
ExecStart=/opt/node-v22.12.0/bin/node --import @swc-node/register/esm-register backend/api/src/vault-main.ts
StandardOutput=append:/var/log/rawprod-demo/vault-api.log
StandardError=append:/var/log/rawprod-demo/vault-api.log
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5s
MemoryMax=400M
# H1: no demo process may reach IMDS (the box role is a PROD role). IPv4 + IPv6 IMDS endpoints.
IPAddressDeny=169.254.169.254/32 fd00:ec2::254/128
Environment=AWS_EC2_METADATA_DISABLED=true
# short-lived demo-role session written by root (vault-demo-aws-creds.timer); credential_process, no credential_source
Environment=AWS_CONFIG_FILE=/etc/rawprod-demo/aws/config AWS_SHARED_CREDENTIALS_FILE=/etc/rawprod-demo/aws/credentials AWS_SDK_LOAD_CONFIG=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
# demo must never starve production on the shared t4g.medium: hard memory cap + half the CPU weight of prod units
CPUWeight=50
[Install]
WantedBy=multi-user.target

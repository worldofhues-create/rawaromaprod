{
 "agent": { "run_as_user": "root", "metrics_collection_interval": 60 },
 "metrics": {
  "namespace": "RawAroma/Host",
  "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
  "metrics_collected": {
   "mem": { "measurement": ["mem_used_percent"] },
   "disk": { "measurement": ["used_percent"], "resources": ["/"] }
  }
 },
 "logs": { "logs_collected": { "files": { "collect_list": [
  { "file_path": "/var/log/rawprod/vault-api.log", "log_group_name": "/rawaroma/rawprod/vault-api", "log_stream_name": "{instance_id}", "retention_in_days": 30 },
  { "file_path": "/var/log/rawprod/metrics.log", "log_group_name": "/rawaroma/rawprod/metrics", "log_stream_name": "{instance_id}", "retention_in_days": 30 },
  { "file_path": "/var/log/rawprod/restore-drill.log", "log_group_name": "/rawaroma/rawprod/restore-drill", "log_stream_name": "{instance_id}", "retention_in_days": 90 },
  { "file_path": "/var/log/nginx/error.log", "log_group_name": "/rawaroma/rawprod/vault-nginx-error", "log_stream_name": "{instance_id}", "retention_in_days": 30 },
  { "file_path": "/var/log/nginx/access.log", "log_group_name": "/rawaroma/rawprod/vault-nginx-access", "log_stream_name": "{instance_id}", "retention_in_days": 30 }
 ] } } }
}

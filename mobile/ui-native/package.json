{
  "name": "@core/ui-native",
  "version": "0.1.0",
  "description": "Tier-1 generic, DOMAIN-FREE React Native component kit (NativeWind 4). Themed only through the SAME semantic tokens as web (@core/tokens), applied as NativeWind CSS vars by ThemeProvider. Ships verbatim in every mobile app. NO domain vocabulary allowed.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tailwind-preset": {
      "types": "./tailwind.preset.ts",
      "import": "./tailwind.preset.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@core/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "nativewind": "^4.1.23",
    "react": "^19.0.0",
    "react-native": "^0.79.0",
    "react-native-safe-area-context": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "nativewind": "^4.1.23",
    "react": "^19.0.0",
    "react-native": "^0.79.0",
    "react-native-safe-area-context": "^5.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  }
}

    "expo-status-bar": "~2.2.3",
    "nativewind": "^4.1.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-native": "^0.79.0",
    "react-native-reanimated": "~3.16.7",

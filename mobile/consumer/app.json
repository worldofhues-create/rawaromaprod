{
  "expo": {
    "name": "Consumer Sample",
    "slug": "core-app-consumer",
    "version": "0.1.0",
    "scheme": "coreconsumer",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.coreconsumer"
    },
    "android": {
      "package": "com.example.coreconsumer"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}

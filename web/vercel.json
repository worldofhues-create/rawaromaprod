{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/crypto/:path*", "destination": "https://raw-aroma-api.onrender.com/crypto/:path*" },
    { "source": "/rpc", "destination": "https://raw-aroma-api.onrender.com/rpc" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}

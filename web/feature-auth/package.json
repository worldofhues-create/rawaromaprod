{
  "name": "@core/feature-auth",
  "version": "0.1.0",
  "description": "Reusable auth screens (login / register / forgot). Tier-2 but generic enough to ship in the template. core/ = TanStack Query mutations + zustand session store (apiClient injected); web/ = react-hook-form + zod forms (schemas from @core/contracts) composed from @core/ui.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts"
    },
    "./web": {
      "types": "./src/web/index.ts",
      "import": "./src/web/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@core/contracts": "workspace:*",
    "@core/ui": "workspace:*",
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.7",
    "react-hook-form": "^7.54.2",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}

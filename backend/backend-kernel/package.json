{
  "name": "@core/backend-kernel",
  "version": "0.1.0",
  "description": "Reusable NestJS core: config, per-schema Drizzle clients, edge layer (guards/interceptors/filters), in-proc event bus + transactional outbox publisher, in-memory flags. Ships with every project.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@core/contracts": "workspace:*",
    "@core/data-iam": "workspace:*",
    "@core/data-kernel": "workspace:*",
    "@core/data-platform": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "drizzle-orm": "^0.38.4",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}

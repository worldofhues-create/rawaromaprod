{
  "name": "@core/api",
  "version": "0.1.0",
  "description": "Sample deployable: NestJS + Fastify HTTP api (edge layer + identity + platform clusters) and a worker entrypoint (outbox publisher + job consumers).",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import @swc-node/register/esm-register --test \"src/**/*.spec.ts\"",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "node --import @swc-node/register/esm-register src/main.ts",
    "dev:worker": "node --import @swc-node/register/esm-register src/worker.ts",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@core/backend-kernel": "workspace:*",
    "@core/cluster-platform": "workspace:*",
    "@core/contracts": "workspace:*",
    "@core/data-iam": "workspace:*",
    "@core/data-platform": "workspace:*",
    "@ra/cluster-org": "workspace:*",
    "@ra/cluster-reference": "workspace:*",
    "@ra/cluster-location": "workspace:*",
    "@ra/cluster-masterdata": "workspace:*",
    "@ra/cluster-procurement": "workspace:*",
    "@ra/cluster-inventory": "workspace:*",
    "@ra/cluster-quality": "workspace:*",
    "@ra/cluster-formula": "workspace:*",
    "@ra/cluster-production": "workspace:*",
    "@ra/cluster-packaging": "workspace:*",
    "@ra/cluster-sales": "workspace:*",
    "@ra/data-masterdata": "workspace:*",
    "@ra/data-procurement": "workspace:*",
    "@ra/data-inventory": "workspace:*",
    "@ra/data-quality": "workspace:*",
    "@ra/data-formula": "workspace:*",
    "@ra/data-production": "workspace:*",
    "@ra/data-packaging": "workspace:*",
    "@ra/data-sales": "workspace:*",
    "@ra/data-bridge": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "fastify": "^4.28.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.1",
    "@types/node": "^22.10.7",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}

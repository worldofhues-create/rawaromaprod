{
  "name": "@ra/cluster-org",
  "version": "0.1.0",
  "description": "RAW AROMACHEM org cluster (iam schema): CRUD over org group/type/org/relationship, business unit, user, role, permission, mappings, and location authority. Foundation masters — no outbox events. Exposes the ORG_LOOKUP cold-read port.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./public-api": {
      "types": "./src/public-api.ts",
      "import": "./src/public-api.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@core/backend-kernel": "workspace:*",
    "@core/contracts": "workspace:*",
    "@core/data-kernel": "workspace:*",
    "@ra/data-org": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "argon2": "^0.41.1",
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}

{
  "name": "@ra/cluster-quality",
  "version": "0.1.0",
  "description": "RAW AROMACHEM quality cluster (quality schema): CRUD over QC parameter catalog, inspections + result details + attachments + disposition, sample retention, and CAPA. Drives the QC inspection flow (results → disposition) and emits quality.qc.passed / quality.qc.failed. Exposes the QUALITY_LOOKUP cold-read port.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./public-api": {
      "types": "./src/public-api.ts",
      "import": "./src/public-api.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@core/backend-kernel": "workspace:*",
    "@core/contracts": "workspace:*",
    "@core/data-kernel": "workspace:*",
    "@ra/data-quality": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}

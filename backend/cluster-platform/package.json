{
  "name": "@core/cluster-platform",
  "version": "0.1.0",
  "description": "Platform cluster (platform schema): control-plane flags + kill-switches, geo suggest, master data. Emits platform.flag.changed and drives the in-memory flag snapshot.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./public-api": {
      "types": "./src/public-api.ts",
      "import": "./src/public-api.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@core/backend-kernel": "workspace:*",
    "@core/contracts": "workspace:*",
    "@core/data-platform": "workspace:*",
    "@core/data-kernel": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "drizzle-orm": "^0.38.4",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}

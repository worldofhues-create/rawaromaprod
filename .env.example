# RAW AROMACHEM — environment template. Copy to .env and fill in. Never commit the real .env.
# Generate the two secrets:
#   JWT_SECRET   :  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#   FORMULA_KEK  :  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # MUST decode to exactly 32 bytes

# ── runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_ENV=prod
PORT=3000
# Run the outbox worker inside the api process (free single-service deploy). Set false if you
# run a dedicated worker dyno.
RUN_WORKER_IN_PROCESS=true

# ── database (Neon) ─────────────────────────────────────────────────────────
# The app's connection (app role). Neon: postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/raw_aroma?sslmode=require
# The formula vault's OWN connection (ideally a separate `ra_vault` role that can read ONLY the
# formula schema — the role-isolation wall). Falls back to DATABASE_URL if unset (Phase-1 single-Neon).
# FORMULA_DATABASE_URL=postgresql://ra_vault:password@ep-xxxx.region.aws.neon.tech/raw_aroma?sslmode=require

# ── auth / crypto ───────────────────────────────────────────────────────────
JWT_SECRET=__set_a_48+_byte_base64_secret__
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=raw-aroma
# Vault key-encryption key (base64, decodes to 32 bytes). Without it, formula encrypt/decrypt
# throws a clear error (the rest of the app still runs).
FORMULA_KEK=__set_a_base64_32_byte_key__

# ── edge / BFF ──────────────────────────────────────────────────────────────
# Comma-separated allowed browser origins. REQUIRED in prod (APP_ENV=prod) — unset = boot error.
CORS_ORIGINS=https://owner.rawaroma.example,https://floor.rawaroma.example

# ── outbox cadence (optional) ───────────────────────────────────────────────
OUTBOX_POLL_MS=2000
OUTBOX_BATCH=100

# ── bridge webhook allow-list (optional) ────────────────────────────────────
# PUT /v1/bridge/config's SSRF guard (packages/contracts/src/clusters/bridge/config.ts) refuses
# a webhookUrl on loopback/RFC1918/link-local/localhost by default. If the ALEMBIC this RawProd
# pairs with is a private host in the SAME VPC/network (a factory deployment, docker-compose,
# CI), list its exact host[:port] here (comma/whitespace-separated, case-insensitive, no
# wildcard, no subnet) to admit it. Unset/empty = every private host still refused, which is the
# safe default. The link-local/cloud-metadata range (169.254.0.0/16, e.g. 169.254.169.254) can
# NEVER be admitted this way, listed or not.
# BRIDGE_WEBHOOK_ALLOWED_HOSTS=factory-alembic.internal:8443

# ── one-time seed (db:seed) ─────────────────────────────────────────────────
# The bootstrap owner login created by `pnpm db:seed`. Use a strong password.
BOOTSTRAP_OWNER_EMAIL=owner@rawaroma.local
BOOTSTRAP_OWNER_PASSWORD=__set_a_strong_password__

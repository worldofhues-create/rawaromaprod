{
  "name": "@ra/data-masterdata",
  "version": "0.1.0",
  "description": "RAW AROMACHEM masterdata cluster (masterdata schema): 7-level warehouse storage tree, material master + classification + alias + storage rules, contact master + outbox + audit. Domain layer (@ra).",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@core/data-kernel": "workspace:*",
    "drizzle-orm": "^0.38.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.30.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

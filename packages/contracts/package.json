{
  "name": "@core/contracts",
  "version": "0.0.0",
  "description": "Single source of truth: zod schemas, DTOs, events, flag & permission registries, error codes.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./registries": "./src/registries/index.ts",
    "./clusters/*": "./src/clusters/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
